{
  "name": "cashtro",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "recon": "pnpm --filter @cashtro/recon start",
    "onboard": "pnpm --filter @cashtro/onboard start",
    "mcp": "pnpm --filter @cashtro/mcp start",
    "secret-scan": "pnpm --filter @cashtro/secret-scan start",
    "web": "pnpm --filter @cashtro/web dev",
    "api": "pnpm --filter @cashtro/api start",
    "api:dev": "pnpm --filter @cashtro/api dev",
    "db:migrate": "pnpm --filter @cashtro/api prisma:migrate",
    "db:seed": "pnpm --filter @cashtro/api prisma:seed",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
