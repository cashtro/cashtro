    {
      "index": 35,
      "section": "core",
      "kind": "trinity",
      "title": "What Trinity is, and your own instance running by the end",
      "body": "This kernel. One local instance. WATCH reads /health.",
      "prev": "f09fea64d9320e15a0780640e15f97d9f8bfd42597fefbcdf2a78074b6cac142",
      "hash": "bf504ad46710c8eda6082ce4db03c39d7f2325e115fee102a082e2c14c56c6de"
    },
    {
      "index": 36,
      "section": "core",
      "kind": "trinity",
      "title": "Bring your existing agents, then build the departments",
      "body": "The registered agentics come first. Chart departments come after.",
      "prev": "bf504ad46710c8eda6082ce4db03c39d7f2325e115fee102a082e2c14c56c6de",
      "hash": "0fb7de622fb7eda38e1ec05d02a75c944ea404196b3a4ff28aea35743934cbb0"
    },
    {
      "index": 37,
      "section": "core",
      "kind": "trinity",
      "title": "Give your agency one shared brain",
      "body": "Einstein is the one shared brain. The hustler relays to him.",
      "prev": "0fb7de622fb7eda38e1ec05d02a75c944ea404196b3a4ff28aea35743934cbb0",
      "hash": "25a230c94d383617a174ce17f5758036363ca88f128ec2f526eafdb7c6544c9f"
    },
    {
      "index": 38,
      "section": "core",
      "kind": "trinity",
      "title": "Orchestration: one agent to run them all",
      "body": "Voltron keeps every chain on.",
      "prev": "25a230c94d383617a174ce17f5758036363ca88f128ec2f526eafdb7c6544c9f",
      "hash": "127b4fb2bc4e98d1b6dd9c754319a88a3407ea69fbe05aeb34927e5098e47a93"
    },
    {
      "index": 39,
      "section": "core",
      "kind": "trinity",
