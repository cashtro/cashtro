      "hash": "1aee2a2bcaf6e2b5ef1c3037f6a8cb04b52e1ba3ab9f0748029cf5723cb2a4dd"
    },
    {
      "index": 36,
      "section": "core",
      "kind": "trinity",
      "title": "Bring your existing agents, then build the departments",
      "body": "The registered agentics come first. Chart departments come after.",
      "prev": "1aee2a2bcaf6e2b5ef1c3037f6a8cb04b52e1ba3ab9f0748029cf5723cb2a4dd",
      "hash": "1005efcc44a18b21accc17d03ef2be010a7a62409b5df0fbfa62f176f5d8efa8"
    },
    {
      "index": 37,
      "section": "core",
      "kind": "trinity",
      "title": "Give your agency one shared brain",
      "body": "Einstein is the one shared brain. The hustler relays to him.",
      "prev": "1005efcc44a18b21accc17d03ef2be010a7a62409b5df0fbfa62f176f5d8efa8",
      "hash": "4d8efb5c1335096c83d972bc112d8aaa90027166218098f2d414f1eb8efde030"
    },
    {
      "index": 38,
      "section": "core",
      "kind": "trinity",
      "title": "Orchestration: one agent to run them all",
      "body": "Voltron keeps every chain on.",
