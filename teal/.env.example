# Copy to .env. Never commit .env.

# Vapi (Vappy) voice lane — talk + outbound, every Evolu-Jeunes bridge.
VAPI_SHARE_URL=https://vapi.ai/
VAPI_ASSISTANT_ID=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_PUBLIC_KEY=
VAPI_VOICE_ID=rachel
VAPI_VOICE_PROVIDER=

# Microsoft Teams AI Teal (Graph). Leave empty to ingest via POST /api/teal/ingest.
TEAMS_TOKEN=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
TEAMS_WEBHOOK_URL=

# Optional: Cashtro OS manager (does not have to be running).
CASHRO_URL=http://127.0.0.1:8080
