# Copy to .env. Never commit .env.

# GitHub — fine-grained PAT (Option A). Leave empty to use `gh auth token`.
GITHUB_TOKEN=

# Optional model bus. Kernel and API boot without this.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Hard cap enforced before dispatch.
HARD_BUDGET_PER_RUN_USD=2

# SQLite by default. Set DATABASE_URL to postgres when ready.
DATABASE_URL="file:../../data/control-plane.db"

# Leave empty: SQLite job table. Set to enable BullMQ.
REDIS_URL=

# API keys for callers (comma-separated id:secret:scope). Example only.
CONTROL_PLANE_API_KEYS=local:change-me:admin

# Vapi (Vappy) voice lane — talk + Start voice on the desk.
# Private key makes POST /api/vapi/talk hit live Vapi (assistant is created if missing).
# Public key launches the in-page Vapi widget. Phone ID is outbound only.
VAPI_SHARE_URL=https://vapi.ai/
VAPI_ASSISTANT_ID=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_PUBLIC_KEY=
VAPI_VOICE_ID=rachel
VAPI_VOICE_PROVIDER=
VAPI_BASE_URL=

# Microsoft Teams AI Teal (Graph). Leave empty to ingest via POST /api/teal/ingest.
TEAMS_TOKEN=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
TEAMS_WEBHOOK_URL=
