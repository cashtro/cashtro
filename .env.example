# Copy to .env. Never commit .env.

# GitHub — fine-grained PAT (Option A). Leave empty to use `gh auth token`.
GITHUB_TOKEN=

# Optional model bus. Kernel and API boot without this.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Hard cap enforced before dispatch.
HARD_BUDGET_PER_RUN_USD=2

# SQLite by default. Set DATABASE_URL to postgres when ready.
DATABASE_URL="file:../../data/control-plane.db"

# Voltron kernel for the http adapter.
VOLTRON_URL=http://127.0.0.1:8080

# Optional self-hosted n8n. Empty = fall back to Voltron. Do not use n8n Cloud.
N8N_BASE_URL=
N8N_API_KEY=

# Leave empty: SQLite job table. Set to enable BullMQ.
REDIS_URL=

# API keys for callers (comma-separated id:secret:scope). Example only.
CONTROL_PLANE_API_KEYS=local:change-me:admin
